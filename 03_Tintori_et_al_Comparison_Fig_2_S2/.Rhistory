SPN4_changing_wide_ann2 <- ann3_tabs_long_spn4bound %>%
filter(RBP_bound == "SPN4")
# change rownames to a column
ann3_tabs_long_spn4bound_trans <- ann3_tabs_long_spn4bound %>%
rownames_to_column(var = "gene")
# pivot data longer
longer_SPN4_changing_ann2 <- ann3_tabs_long_spn4bound_trans %>%
pivot_longer(cols = c(2:28), names_to = "cell", values_to = "intensity")
# Set factor order
longer_SPN4_changing_ann2$cell <- factor(longer_SPN4_changing_ann2$cell, levels = lineageOrder[2:28])
longer_SPN4_changing_ann2$gene <- factor(longer_SPN4_changing_ann2$gene)
# Plot
ggplot(longer_SPN4_changing_ann2, aes(x = cell, y = intensity, group = gene))+
geom_line(aes(colour = gene), show.legend = FALSE, alpha = 0.2) +
facet_grid(rows = vars(RBP_bound))
longer_SPN4_changing_ann2
SPN4_changing_wide_ann2 <- ann3_tabs_long_spn4bound %>%
filter(RBP_bound == "SPN4")
SPN4_changing_wide_ann2
# change rownames to a column
ann3_tabs_long_spn4bound_trans <- SPN4_changing_wide_ann2 %>%
rownames_to_column(var = "gene")
# pivot data longer
longer_SPN4_changing_ann2 <- ann3_tabs_long_spn4bound_trans %>%
pivot_longer(cols = c(2:28), names_to = "cell", values_to = "intensity")
# Set factor order
longer_SPN4_changing_ann2$cell <- factor(longer_SPN4_changing_ann2$cell, levels = lineageOrder[2:28])
longer_SPN4_changing_ann2$gene <- factor(longer_SPN4_changing_ann2$gene)
longer_SPN4_changing_ann2
ggplot(longer_SPN4_changing_ann2, aes(x = cell, y = intensity, group = gene))+
geom_line(aes(colour = gene), show.legend = FALSE, alpha = 0.2)
# Plot
spn4_multilineplot <- ggplot(longer_SPN4_changing_ann2, aes(x = cell, y = intensity, group = gene))+
geom_line(aes(colour = gene), show.legend = FALSE, alpha = 0.2)
setwd(mywd)
today <- format(Sys.Date(), "%y%m%d")
filename5 <- paste("03_output/", today, "_multiLineplots_SPN4Only_zscored.pdf", sep = "")
pdf(filename5, width = 6, height = 6)
spn4_multilineplot
dev.off()
