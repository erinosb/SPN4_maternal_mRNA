# Create a new ann2 annotation table that combines the cluster and IP categories
ann2 <- merged_cluster_IP[,c(2,4)]
rownames(ann2) <- merged_cluster_IP$Sequence_Name
colnames(ann2) <- c("cluster_set", "IP")
