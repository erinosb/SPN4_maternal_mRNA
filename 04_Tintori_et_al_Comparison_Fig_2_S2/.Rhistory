ALL_7 <- read.table(file = "01_input/lists_from_02/20250711_OMA1_SPN4_LIN41_list.txt")
# annotate the dataframes:
OMA1_1 <- OMA1_1 %>%
mutate(IP = "OMA-1")
SPN4_2 <- SPN4_2 %>%
mutate(IP = "SPN-4")
LIN41_3 <- LIN41_3 %>%
mutate(IP = "LIN-41")
OMA1LIN41_4 <- OMA1LIN41_4 %>%
mutate(IP = "OMA-1_LIN-41")
OMA1SPN4_5 <- OMA1SPN4_5 %>%
mutate(IP = "OMA-1_SPN-4")
