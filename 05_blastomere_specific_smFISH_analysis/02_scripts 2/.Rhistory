ymax = mean_abundance + sd_abundance),
width = 0.2) +
facet_wrap(~ mRNA_name) +
labs(
title = "Mean mRNA abundance per cell",
x = "Cell",
y = "Mean abundance",
fill = "Lineage"
) +
theme_minimal(base_size = 14) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
