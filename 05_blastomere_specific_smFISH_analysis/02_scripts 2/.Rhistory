# === 2. Compute summary statistics per cell ===
cell_summary <- df_long %>%
group_by(label, mRNA_name) %>%
summarise(
mean_abundance = mean(abundance, na.rm = TRUE),
sd_abundance   = sd(abundance, na.rm = TRUE),
.groups = "drop"
) %>%
# Add lineage manually based on known cell type
mutate(
lineage = case_when(
label %in% c("AB", "ABa", "ABb", "EMS") ~ "Somatic",
label %in% c("P1", "P2", "P3", "P4") ~ "Germline",
TRUE ~ NA_character_
)
)
# View the summary table
print(cell_summary)
# === 3. Basic plot: barplot with error bars ===
ggplot(cell_summary, aes(x = label, y = mean_abundance, fill = lineage)) +
geom_bar(stat = "identity", position = "dodge") +
geom_errorbar(aes(ymin = mean_abundance - sd_abundance,
ymax = mean_abundance + sd_abundance),
width = 0.2) +
facet_wrap(~ mRNA_name) +
labs(
title = "Mean mRNA abundance per cell",
x = "Cell",
y = "Mean abundance",
fill = "Lineage"
) +
theme_minimal(base_size = 14) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
