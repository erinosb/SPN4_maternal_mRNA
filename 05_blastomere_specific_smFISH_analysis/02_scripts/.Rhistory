addToTTestStats <- function(cell1, cell2, row) {
filtered_df <- scaled_lin41_selection %>%
filter(label == cell1 | label == cell2)
tTest_stats[row,1] <- cell1
tTest_stats[row,2] <- cell2
tTest_stats[row,3] <- t.test(abundance_by_vol ~ label, filtered_df)$statistic
tTest_stats[row,4] <- t.test(abundance_by_vol ~ label, filtered_df)$p.value
}
