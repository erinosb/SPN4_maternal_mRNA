scaled_lin41_selection
summary(scaled_lin41_selection)
scaled_lin41_selection %>%
filter(label == "AB" | label == "P1")
ABvP1 <- scaled_lin41_selection %>%
filter(label == "AB" | label == "P1")
colnames(ABvP1)
t.test(abundance_by_vol ~ label, ABvP1)
# t-test for EMS v. P2
EMSvP2 <- scaled_lin41_selection %>%
filter(label == "EMS" | label == "P2")
t.test(abundance_by_vol ~ label, EMSvP2)
t.test(abundance_by_vol ~ label, scaled_lin41_selection)
# t-test for EMS v. P2
ABaABp <- scaled_lin41_selection %>%
filter(label == "ABa" | label == "ABp")
t.test(abundance_by_vol ~ label, ABaABp)
